    <task xml:id="task-gt-cosine-second" workspace="0.35in">
      <statement>
        <p>
          Compute <m>g''(x)</m>, find its roots and vertical asymptotes, and complete the sign chart.
        </p>
        <image width="60%">
          <shortdescription>A number line from 0 to 2 pi with tick marks at 0, pi over 2, pi, 3 pi over 2, and 2 pi, and dotted lines above each tick mark. The space above the number line is blank for a sign chart of g double prime of x.</shortdescription>
          <latex-image>
            \begin{tikzpicture}
            \draw[thick] (0,0) -- (8.8,0);
            \draw[thick] (0.0,0.12) -- (0.0,-0.12);
            \draw[dotted] (0.0,0.12) -- (0.0,1.4);
            \node[below] at (0.0,-0.12) {$0$};
            \draw[thick] (2.2,0.12) -- (2.2,-0.12);
            \draw[dotted] (2.2,0.12) -- (2.2,1.4);
            \node[below] at (2.2,-0.12) {$\pi/2$};
            \draw[thick] (4.4,0.12) -- (4.4,-0.12);
            \draw[dotted] (4.4,0.12) -- (4.4,1.4);
            \node[below] at (4.4,-0.12) {$\pi$};
            \draw[thick] (6.6,0.12) -- (6.6,-0.12);
            \draw[dotted] (6.6,0.12) -- (6.6,1.4);
            \node[below] at (6.6,-0.12) {$3\pi/2$};
            \draw[thick] (8.8,0.12) -- (8.8,-0.12);
            \draw[dotted] (8.8,0.12) -- (8.8,1.4);
            \node[below] at (8.8,-0.12) {$2\pi$};
            \node[right] at (9.2,0) {$g''(x)$};
            \end{tikzpicture}
          </latex-image>
        </image>
      </statement>
    </task>
    <task xml:id="task-gt-cosine-table" workspace="0in">
      <statement>
        <p>
          Complete the table for <m>g(x)=\cos(x)</m>.
        </p>
        <tabular halign="center" top="minor" left="minor">
          <col right="minor"/><col right="minor"/><col right="minor"/><col right="minor"/><col right="minor"/>
          <row header="yes" bottom="minor"><cell>Quadrant</cell><cell>Interval</cell><cell>Sign of <m>g</m></cell><cell>Direction</cell><cell>Concavity</cell></row>
          <row bottom="minor"><cell><m>\text{I}</m></cell><cell><m>(0,\pi/2)</m></cell><cell><m>\phantom{\text{negative}}</m></cell><cell><m>\phantom{\text{decreasing}}</m></cell><cell><m>\phantom{\text{concave down}}</m></cell></row>
          <row bottom="minor"><cell><m>\text{II}</m></cell><cell><m>(\pi/2,\pi)</m></cell><cell><m>\phantom{\text{negative}}</m></cell><cell><m>\phantom{\text{decreasing}}</m></cell><cell><m>\phantom{\text{concave down}}</m></cell></row>
          <row bottom="minor"><cell><m>\text{III}</m></cell><cell><m>(\pi,3\pi/2)</m></cell><cell><m>\phantom{\text{negative}}</m></cell><cell><m>\phantom{\text{decreasing}}</m></cell><cell><m>\phantom{\text{concave down}}</m></cell></row>
          <row bottom="minor"><cell><m>\text{IV}</m></cell><cell><m>(3\pi/2,2\pi)</m></cell><cell><m>\phantom{\text{negative}}</m></cell><cell><m>\phantom{\text{decreasing}}</m></cell><cell><m>\phantom{\text{concave down}}</m></cell></row>
        </tabular>
      </statement>
    </task>
    <task xml:id="task-gt-cosine-sketch" workspace="0in">
      <statement>
        <p>
          Sketch the graph of <m>g(x)=\cos(x)</m> on <m>[0,2\pi]</m>. Label the roots, the maximum and minimum values, and the inflection points.
        </p>
        <image width="70%">
          <shortdescription>Blank axes for sketching cosine on the interval from 0 to 2 pi. Vertical dotted guide lines mark multiples of pi over 2, and the vertical axis is marked at 1 and negative 1.</shortdescription>
          <latex-image>
            \begin{tikzpicture}
            \foreach \x in {2.2,4.4,6.6,8.8} \draw[dotted,gray] (\x,2.0) -- (\x,-2.0);
            \draw[-&gt;] (-0.5,0) -- (9.4,0) node[right] {$x$};
            \draw[-&gt;] (0,-2.0) -- (0,2.0) node[above] {$y$};
            \draw (0.0,0.1) -- (0.0,-0.1);
            \node[below] at (0.0,-0.1) {$0$};
            \draw (2.2,0.1) -- (2.2,-0.1);
            \node[below] at (2.2,-0.1) {$\pi/2$};
            \draw (4.4,0.1) -- (4.4,-0.1);
            \node[below] at (4.4,-0.1) {$\pi$};
            \draw (6.6,0.1) -- (6.6,-0.1);
            \node[below] at (6.6,-0.1) {$3\pi/2$};
            \draw (8.8,0.1) -- (8.8,-0.1);
            \node[below] at (8.8,-0.1) {$2\pi$};
            \draw (-0.1,1.5) -- (0.1,1.5);
            \node[left] at (-0.1,1.5) {$1$};
            \draw (-0.1,-1.5) -- (0.1,-1.5);
            \node[left] at (-0.1,-1.5) {$-1$};
            \end{tikzpicture}
          </latex-image>
        </image>
      </statement>
    </task>
  </exercise>

  <exercise xml:id="ex-gt-secant" workspace="0in">
    <title>The Shape of Secant</title>
    <introduction>
      <p>
        Now let <m>h(x)=\sec(x)</m> on <m>[0,2\pi]</m>. Write <m>h</m> and its derivatives in terms of
        sine and cosine, and be careful to look for division by zero.
      </p>
    </introduction>
    <task xml:id="task-gt-secant-chart" workspace="0.35in">
      <statement>
        <p>
          Find the roots and vertical asymptotes of <m>h(x)=\sec(x)</m> and complete the sign chart.
        </p>
        <image width="60%">
          <shortdescription>A number line from 0 to 2 pi with tick marks at 0, pi over 2, pi, 3 pi over 2, and 2 pi, and dotted lines above each tick mark. The space above the number line is blank for a sign chart of h of x.</shortdescription>
          <latex-image>
            \begin{tikzpicture}
            \draw[thick] (0,0) -- (8.8,0);
            \draw[thick] (0.0,0.12) -- (0.0,-0.12);
            \draw[dotted] (0.0,0.12) -- (0.0,1.4);
            \node[below] at (0.0,-0.12) {$0$};
            \draw[thick] (2.2,0.12) -- (2.2,-0.12);
            \draw[dotted] (2.2,0.12) -- (2.2,1.4);
            \node[below] at (2.2,-0.12) {$\pi/2$};
            \draw[thick] (4.4,0.12) -- (4.4,-0.12);
            \draw[dotted] (4.4,0.12) -- (4.4,1.4);
            \node[below] at (4.4,-0.12) {$\pi$};
            \draw[thick] (6.6,0.12) -- (6.6,-0.12);
            \draw[dotted] (6.6,0.12) -- (6.6,1.4);
            \node[below] at (6.6,-0.12) {$3\pi/2$};
            \draw[thick] (8.8,0.12) -- (8.8,-0.12);
            \draw[dotted] (8.8,0.12) -- (8.8,1.4);
            \node[below] at (8.8,-0.12) {$2\pi$};
            \node[right] at (9.2,0) {$h(x)$};
            \end{tikzpicture}
          </latex-image>
        </image>
      </statement>
    </task>
    <task xml:id="task-gt-secant-first" workspace="0.35in">
      <statement>
        <p>
          Compute <m>h'(x)</m>, rewrite it using sine and cosine, find its roots and vertical asymptotes, and complete the sign chart.
        </p>
        <image width="60%">
          <shortdescription>A number line from 0 to 2 pi with tick marks at 0, pi over 2, pi, 3 pi over 2, and 2 pi, and dotted lines above each tick mark. The space above the number line is blank for a sign chart of h prime of x.</shortdescription>
          <latex-image>
            \begin{tikzpicture}
            \draw[thick] (0,0) -- (8.8,0);
            \draw[thick] (0.0,0.12) -- (0.0,-0.12);
            \draw[dotted] (0.0,0.12) -- (0.0,1.4);
            \node[below] at (0.0,-0.12) {$0$};
            \draw[thick] (2.2,0.12) -- (2.2,-0.12);
            \draw[dotted] (2.2,0.12) -- (2.2,1.4);
            \node[below] at (2.2,-0.12) {$\pi/2$};
            \draw[thick] (4.4,0.12) -- (4.4,-0.12);
            \draw[dotted] (4.4,0.12) -- (4.4,1.4);
            \node[below] at (4.4,-0.12) {$\pi$};
            \draw[thick] (6.6,0.12) -- (6.6,-0.12);
            \draw[dotted] (6.6,0.12) -- (6.6,1.4);
            \node[below] at (6.6,-0.12) {$3\pi/2$};
            \draw[thick] (8.8,0.12) -- (8.8,-0.12);
            \draw[dotted] (8.8,0.12) -- (8.8,1.4);
            \node[below] at (8.8,-0.12) {$2\pi$};
            \node[right] at (9.2,0) {$h'(x)$};
            \end{tikzpicture}
          </latex-image>
        </image>
      </statement>
    </task>
    <task xml:id="task-gt-secant-second" workspace="1.05in">
      <statement>
        <p>
          Compute <m>h''(x)</m>. Simplify until the numerator and denominator are each something whose sign you can read from the unit circle. Then find the roots and vertical asymptotes of <m>h''</m> and complete the sign chart.
        </p>
        <image width="60%">
          <shortdescription>A number line from 0 to 2 pi with tick marks at 0, pi over 2, pi, 3 pi over 2, and 2 pi, and dotted lines above each tick mark. The space above the number line is blank for a sign chart of h double prime of x.</shortdescription>
          <latex-image>
            \begin{tikzpicture}
            \draw[thick] (0,0) -- (8.8,0);
            \draw[thick] (0.0,0.12) -- (0.0,-0.12);
            \draw[dotted] (0.0,0.12) -- (0.0,1.4);
            \node[below] at (0.0,-0.12) {$0$};
            \draw[thick] (2.2,0.12) -- (2.2,-0.12);
            \draw[dotted] (2.2,0.12) -- (2.2,1.4);
            \node[below] at (2.2,-0.12) {$\pi/2$};
            \draw[thick] (4.4,0.12) -- (4.4,-0.12);
            \draw[dotted] (4.4,0.12) -- (4.4,1.4);
            \node[below] at (4.4,-0.12) {$\pi$};
            \draw[thick] (6.6,0.12) -- (6.6,-0.12);
            \draw[dotted] (6.6,0.12) -- (6.6,1.4);
            \node[below] at (6.6,-0.12) {$3\pi/2$};
            \draw[thick] (8.8,0.12) -- (8.8,-0.12);
            \draw[dotted] (8.8,0.12) -- (8.8,1.4);
            \node[below] at (8.8,-0.12) {$2\pi$};
            \node[right] at (9.2,0) {$h''(x)$};
            \end{tikzpicture}
          </latex-image>
        </image>
      </statement>
    </task>
    <task xml:id="task-gt-secant-table" workspace="0in">
      <statement>
        <p>
          Complete the table for <m>h(x)=\sec(x)</m>.
        </p>
        <tabular halign="center" top="minor" left="minor">
          <col right="minor"/><col right="minor"/><col right="minor"/><col right="minor"/><col right="minor"/>
          <row header="yes" bottom="minor"><cell>Quadrant</cell><cell>Interval</cell><cell>Sign of <m>h</m></cell><cell>Direction</cell><cell>Concavity</cell></row>
          <row bottom="minor"><cell><m>\text{I}</m></cell><cell><m>(0,\pi/2)</m></cell><cell><m>\phantom{\text{negative}}</m></cell><cell><m>\phantom{\text{decreasing}}</m></cell><cell><m>\phantom{\text{concave down}}</m></cell></row>
          <row bottom="minor"><cell><m>\text{II}</m></cell><cell><m>(\pi/2,\pi)</m></cell><cell><m>\phantom{\text{negative}}</m></cell><cell><m>\phantom{\text{decreasing}}</m></cell><cell><m>\phantom{\text{concave down}}</m></cell></row>
          <row bottom="minor"><cell><m>\text{III}</m></cell><cell><m>(\pi,3\pi/2)</m></cell><cell><m>\phantom{\text{negative}}</m></cell><cell><m>\phantom{\text{decreasing}}</m></cell><cell><m>\phantom{\text{concave down}}</m></cell></row>
          <row bottom="minor"><cell><m>\text{IV}</m></cell><cell><m>(3\pi/2,2\pi)</m></cell><cell><m>\phantom{\text{negative}}</m></cell><cell><m>\phantom{\text{decreasing}}</m></cell><cell><m>\phantom{\text{concave down}}</m></cell></row>
        </tabular>
      </statement>
    </task>
    <task xml:id="task-gt-secant-sketch" workspace="0in">
      <statement>
        <p>
          Sketch the graph of <m>h(x)=\sec(x)</m> on <m>[0,2\pi]</m>. Draw each vertical asymptote as a dashed line, and for each side of each asymptote use your table to decide whether the graph rises to <m>+\infty</m> or falls to <m>-\infty</m>. Label the local extreme values.
        </p>
        <image width="70%">
          <shortdescription>Blank axes for sketching secant on the interval from 0 to 2 pi. Vertical dotted guide lines mark multiples of pi over 2, and the vertical axis is marked at 1 and negative 1.</shortdescription>
          <latex-image>
            \begin{tikzpicture}
            \foreach \x in {2.2,4.4,6.6,8.8} \draw[dotted,gray] (\x,3.0) -- (\x,-3.0);
            \draw[-&gt;] (-0.5,0) -- (9.4,0) node[right] {$x$};
            \draw[-&gt;] (0,-3.0) -- (0,3.0) node[above] {$y$};
            \draw (0.0,0.1) -- (0.0,-0.1);
            \node[below] at (0.0,-0.1) {$0$};
            \draw (2.2,0.1) -- (2.2,-0.1);
            \node[below] at (2.2,-0.1) {$\pi/2$};
            \draw (4.4,0.1) -- (4.4,-0.1);
            \node[below] at (4.4,-0.1) {$\pi$};
            \draw (6.6,0.1) -- (6.6,-0.1);
            \node[below] at (6.6,-0.1) {$3\pi/2$};
            \draw (8.8,0.1) -- (8.8,-0.1);
            \node[below] at (8.8,-0.1) {$2\pi$};
            \draw (-0.1,0.8) -- (0.1,0.8);
            \node[left] at (-0.1,0.8) {$1$};
            \draw (-0.1,-0.8) -- (0.1,-0.8);
            \node[left] at (-0.1,-0.8) {$-1$};
            \end{tikzpicture}
          </latex-image>
        </image>
      </statement>
    </task>
  </exercise>
</worksheet>
